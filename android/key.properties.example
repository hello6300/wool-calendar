# 示例文件，仅供本地参考。复制为 android/key.properties 后填写真实值。
# ⚠ android/key.properties 已加入 .gitignore，严禁提交；CI 中由 workflow 从 Secrets 生成。
# storeFile 是相对 android/app/build.gradle 的路径，keystore 放在 android/app/ 下。
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
storeFile=upload-keystore.jks
